# Copy this to edge/.env and fill in your values.
# edge/.env is gitignored (it holds the camera password) — never commit it.

# Full RTSP URL of the Tapo camera (stream2 = lower-res, cheaper to upload).
TAPO_RTSP_URL=rtsp://USER:PASSWORD@10.0.0.228:554/stream2

# S3 bucket for candidate frames (deploy output CandidateFramesBucketName).
# The stack names it eip-candidate-frames-<stage>-<your-aws-account-id>.
EIP_FRAMES_BUCKET=eip-candidate-frames-dev-<YOUR_AWS_ACCOUNT_ID>

# Zone label + poll interval.
EIP_ZONE=porch
EIP_POLL_SECONDS=15

# Safety net: upload a frame at least this often even with no motion, so a cat
# sitting still (which produces no frame-diff) is still recognized. Lower = catches
# stationary Zeus faster but more cloud recognitions (cost). 60s is a good start.
EIP_HEARTBEAT_SECONDS=60

# AWS credentials: uses your ~/.aws by default. To use the least-privilege edge
# uploader key instead, uncomment and fill these:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
